{
  "name": "@nf/server",
  "version": "0.0.0",
  "private": true,
  "description": "Authoritative game server: Colyseus rooms and HTTP API",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nf/db": "workspace:*",
    "@nf/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nf/config": "workspace:*"
  }
}
