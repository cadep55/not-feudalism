# Copy to .env for local development: `cp .env.example .env` (PowerShell: `Copy-Item .env.example .env`).
# These values match docker-compose.yml and are for your PC only. Real secrets never go in git.

# Environment: development | test | production
NODE_ENV=development

# PostgreSQL connection (used by packages/db and apps/server)
DATABASE_URL=postgres://nf:nf_dev_password@localhost:5432/not_feudalism

# Game server
PORT=2567
# Browser origin allowed to call the server (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
