{
  "name": "not-feudalism",
  "private": true,
  "description": "Multiplayer medieval strategy game for the browser",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && turbo run typecheck test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "lefthook": "2.2.1",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
