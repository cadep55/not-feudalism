{
  "name": "not-feudalism",
  "private": true,
  "description": "Multiplayer medieval strategy game for the browser",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm db:up && pnpm db:migrate && turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "pnpm --filter @nf/e2e test:e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && turbo run typecheck test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "db:generate": "pnpm --filter @nf/db db:generate",
    "db:migrate": "pnpm --filter @nf/db db:migrate",
    "db:seed": "pnpm --filter @nf/db db:seed",
    "db:studio": "pnpm --filter @nf/db db:studio",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "24.19.2",
    "lefthook": "2.2.2",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
